# Dashboard istituzionale (T20) - stessa base del bot, entrypoint diverso.
FROM python:3.12-slim
WORKDIR /app

COPY pyproject.toml ./
COPY tradingagents ./tradingagents
COPY dashboard ./dashboard
RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir "fastapi>=0.111" "uvicorn[standard]>=0.30" "websockets>=12"

# state/ (bot.db + cycle_report.json + bot.log) resta un volume condiviso col bot.
VOLUME /app/state
EXPOSE 8080
CMD ["uvicorn", "dashboard.server:app", "--host", "0.0.0.0", "--port", "8080"]
