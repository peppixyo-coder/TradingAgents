# Dashboard istituzionale (T20) - deriva dall'immagine bot (già con tutte le dipendenze);
# aggiunge solo il modulo dashboard e lo stack web.
FROM hyperliquid_trading_agents-trading-bot:latest
WORKDIR /app
COPY dashboard ./dashboard
RUN pip install --no-cache-dir "fastapi>=0.111" "uvicorn[standard]>=0.30" "websockets>=12"

# state/ (bot.db + cycle_report.json + bot.log) resta un volume condiviso col bot.
VOLUME /app/state
EXPOSE 8080
CMD ["uvicorn", "dashboard.server:app", "--host", "0.0.0.0", "--port", "8080"]
